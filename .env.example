# Root database credentials used by the shared PostgreSQL service.
POSTGRES_USER=pulsefit
POSTGRES_PASSWORD=pulsefit_password
POSTGRES_DB=pulsefit

# JDBC URL for the application database inside the shared PostgreSQL service.
APP_DB_URL=jdbc:postgresql://postgres:5432/pulsefit

# Keycloak bootstrap admin credentials for first-run console access.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin-password

# Keycloak database connection values.
KEYCLOAK_DB_HOST=postgres
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db-password

# OIDC values consumed by the frontend and backend.
KEYCLOAK_ISSUER_URI=http://keycloak:8080/auth/realms/pulsefit
KEYCLOAK_REALM=pulsefit
KEYCLOAK_CLIENT_ID=pulsefit-frontend
KEYCLOAK_CLIENT_SECRET=change-me-frontend-client-secret

# Stripe secret material and price ids.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID_MONTHLY_PACK=price_replace_me
STRIPE_PRICE_ID_DROP_IN=price_replace_me_drop_in

# Public URLs used by the reverse proxy and OAuth redirects.
APP_PUBLIC_BASE_URL=http://localhost
FRONTEND_BASE_URL=http://localhost
BACKEND_BASE_URL=http://localhost/api

# Frontend build-time variables injected into the Vite bundle.
VITE_API_BASE_URL=/api
VITE_KEYCLOAK_URL=http://localhost/auth
VITE_KEYCLOAK_REALM=pulsefit
VITE_KEYCLOAK_CLIENT_ID=pulsefit-frontend
VITE_APP_BASE_URL=http://localhost
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Security and CORS.
JWT_AUDIENCE=pulsefit-backend
CORS_ALLOWED_ORIGINS=http://localhost
