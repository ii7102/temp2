{
  "realm": "pulsefit",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "roles": {
    "realm": [
      { "name": "guest", "description": "Unauthenticated browsing role" },
      { "name": "user", "description": "Registered member" },
      { "name": "admin", "description": "Platform administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "pulsefit-frontend",
      "name": "PulseFit Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost",
      "baseUrl": "http://localhost",
      "redirectUris": ["http://localhost/*", "https://__FRONTEND_HOST__/*"],
      "webOrigins": ["http://localhost", "https://__FRONTEND_HOST__"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "backend-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "pulsefit-backend",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "pulsefit-backend",
      "name": "PulseFit Backend",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "__REPLACE_WITH_ENV_PULSEFIT_BACKEND_CLIENT_SECRET__",
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost/*", "https://__BACKEND_HOST__/*"],
      "webOrigins": ["http://localhost", "https://__BACKEND_HOST__"]
    }
  ],
  "defaultDefaultClientScopes": ["profile", "email", "roles", "web-origins"]
}
